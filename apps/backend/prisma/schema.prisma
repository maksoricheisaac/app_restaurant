generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- CORE SAAS MODELS ---

model Tenant {
  id           String       @id @default(uuid())
  name         String
  // Pas de @unique ici : l'unicité réelle est un index unique PARTIEL
  // (WHERE "deletedAt" IS NULL) créé en SQL brut dans une migration, pour
  // qu'un tenant soft-deleted libère son slug/ses identifiants de paiement
  // au lieu de les squatter indéfiniment. Voir migration
  // add_tenant_soft_delete_partial_unique_constraints.
  slug         String       // Utilisé pour {slug}.flashmenu.app
  // Clé du plan (Plan.key) — plus une enum figée : les plans sont désormais
  // pilotés par les données (table Plan), administrables depuis le Super Admin.
  // Couplage lâche par clé (pas de FK dure) pour qu'un plan puisse être
  // désactivé/soft-deleted sans bloquer les tenants qui y sont rattachés.
  plan         String       @default("free")
  status       TenantStatus @default(active)
  logo             String?
  logoPathname     String?   // Blob pathname for cleanup on replace/delete
  bannerUrl        String?   // Public URL (Vercel Blob)
  bannerPathname   String?   // Internal blob pathname for delete/replace
  primaryColor String   @default("#f97316")
  country      String?
  currency     String   @default("EUR")
  timezone     String   @default("Europe/Paris")
  cuisineType  String?
  onboardingCompleted Boolean @default(false)

  // Fournisseur de paiement agnostique — voir apps/backend/src/payments.
  // paymentProvider identifie quel PaymentProvider a créé l'abonnement
  // (ex: "moneroo", "stripe"...) afin de pouvoir router les opérations
  // ultérieures (statut, annulation) vers le bon provider.
  paymentProvider             String?
  // Idem slug : unicité imposée par un index partiel WHERE "deletedAt" IS NULL.
  paymentCustomerId           String?
  paymentSubscriptionId       String?
  subscriptionStatus    String?   // active | past_due | canceled | trialing | unpaid
  subscriptionCurrentPeriodEnd DateTime?
  gracePeriodEndsAt     DateTime? // paid grace after payment failure (3 days)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft delete — la suppression physique d'un tenant est interdite

  // Relations métier
  memberships         TenantMembership[]
  membershipInvites   MembershipInvite[]
  users               User[]
  customers           Customer[]
  orders              Order[]
  menuItems           MenuItem[]
  menuCategories      MenuCategory[]
  tables              Table[]
  reservations        Reservation[]
  ingredients         Ingredient[]
  recipes             Recipe[]
  stockMovements      StockMovement[]
  payments            Payment[]
  transactions        Transaction[]
  cashRegisterSessions CashRegisterSession[]
  deliveryZones       DeliveryZone[]
  openingHours        OpeningHours[]
  exceptionalClosures ExceptionalClosure[]
  settings            RestaurantSettings[]
  messages            Message[]
  reports             Report[]
  featureFlags        FeatureFlag[]
  domains             Domain[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  @@index([slug])
  @@index([deletedAt])
}

/// Plan d'abonnement piloté par les données. Source de vérité UNIQUE des
/// prix, limites, features et méta-marketing des offres. Administrable
/// entièrement depuis le Super Admin (CRUD). Tenant.plan référence `key`.
///
/// Convention limites : `-1` = illimité. Le backend convertit vers le
/// sentinel applicatif (UNLIMITED) au moment de la lecture.
model Plan {
  id           String  @id @default(uuid())
  key          String  @unique // 'free' | 'pro' | 'enterprise' | clé custom
  name         String
  tagline      String?
  description  String?

  monthlyPrice Int     @default(0) // unités majeures de la devise (ex: euros)
  annualPrice  Int     @default(0)
  currency     String  @default("EUR")

  // Limites (-1 = illimité)
  maxMenuItems     Int @default(-1)
  maxTables        Int @default(-1)
  maxStaffMembers  Int @default(-1)
  maxMonthlyOrders Int @default(-1)

  // Fonctionnalités : map extensible { kds, advancedReports, apiAccess,
  // multiSite, customBranding, ... }. JSON pour ajouter une feature sans
  // migration de schéma.
  features   Json     @default("{}")
  highlights String[] // arguments marketing (page pricing / onboarding)

  badge     String? // ex: "Le plus populaire"
  isActive  Boolean @default(true) // souscriptible / applique ses limites
  isPublic  Boolean @default(true) // visible pricing + onboarding
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete — un plan référencé n'est jamais supprimé physiquement

  @@index([isActive, isPublic])
  @@index([deletedAt])
}

model TenantMembership {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  role        String // owner, manager, waiter, head_chef, chef, cashier
  permissions String[] // Override optionnel de permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Invitation d'un employé n'ayant pas encore de compte FlashMenu. Suit le
/// même patron que RefreshToken/emailVerificationToken : seul le hash
/// SHA-256 du jeton est stocké, le jeton brut n'existe que dans le lien
/// envoyé par email. Si l'email invité correspond déjà à un compte existant,
/// MembershipsService.invite() garde le chemin rapide historique (ajout
/// immédiat) sans passer par cette table.
model MembershipInvite {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email     String
  role      String
  tokenHash String       @unique
  status    InviteStatus @default(pending)

  invitedBy     String
  invitedByUser User     @relation("InviteInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([email])
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model Domain {
  id       String  @id @default(uuid())
  domain   String  @unique
  tenantId String
  verified Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id       String  @id @default(uuid())
  tenantId String
  key      String
  enabled  Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model User {
  id            String  @id @default(uuid())
  name          String
  firstName     String?
  lastName      String?
  email         String  @unique
  emailVerified Boolean @default(false)
  password      String
  image         String?
  phone         String?
  status        UserStatus   @default(active)
  platformRole  PlatformRole @default(user)

  // Onboarding : seul l'état « terminé » est persisté. Les données du wizard
  // (restaurant, plan…) ne touchent la base qu'à la finalisation, dans une
  // transaction unique (voir OnboardingService.completeOnboarding).
  onboardingCompleted Boolean @default(false)

  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?

  passwordResetToken       String?   @unique
  passwordResetExpiry      DateTime?

  // Relation multi-tenant
  tenantId    String? // Dernier tenant accédé ou tenant principal
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  memberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  payments        Payment[]
  reservations    Reservation[]
  stockMovements  StockMovement[]
  transactions    Transaction[]
  userPermissions UserPermission[]
  refreshTokens   RefreshToken[]
  cashSessionsOpened CashRegisterSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashRegisterSession[] @relation("CashSessionClosedBy")
  invitesSent        MembershipInvite[]    @relation("InviteInvitedBy")

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime? // Null = jamais utilisé. Non-null = utilisé → replay si réutilisé

  @@index([userId])
  @@index([userId, usedAt])
}

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String?
  email        String?
  phone        String?
  authProvider String? // email | google | anonymous
  externalId   String? // google id
  isAnonymous  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  orders Order[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, deletedAt])
}

model RestaurantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                 String
  phone                String?
  email                String?
  address              String?
  description          String?
  website              String?
  logo                 String?

  deliveryEnabled      Boolean @default(true)
  takeawayEnabled      Boolean @default(true)
  dineInEnabled        Boolean @default(true)
  maxOrdersPerHour     Int     @default(10)
  maxOrdersPerUserHour Int     @default(3)
  maxReservationGuests Int     @default(20)
  maxDaysInAdvance     Int     @default(30)

  facebookUrl          String?
  instagramUrl         String?
  twitterUrl           String?
  youtubeUrl           String?
}

model Table {
  id       String      @id @default(uuid())
  number   Int
  seats    Int
  location String?
  status   TableStatus @default(available)
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deletedAt DateTime? // Soft delete — unicité (tenantId, number) gérée applicativement

  orders       Order[]
  reservations Reservation[]

  // Contrainte unique retirée au profit d'un index simple + vérification applicative
  // pour permettre le soft delete (un nouveau numéro peut remplacer un table supprimée)
  @@index([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Reservation {
  id       String            @id @default(uuid())
  date     DateTime
  time     String?
  guests   Int?
  status   ReservationStatus @default(pending)
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerName String?
  email        String?
  phone        String?
  userId       String?
  tableId      String?

  deletedAt DateTime? // Soft delete — protège l'historique des réservations

  table Table? @relation(fields: [tableId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, date]) // Filtrage par date (dashboard, liste des réservations)
}

model MenuCategory {
  id            String    @id @default(uuid())
  name          String
  tenantId      String
  imageUrl      String?   // Public URL (Vercel Blob)
  imagePathname String?   // Internal blob pathname for delete/replace
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt     DateTime? // Soft delete

  items MenuItem[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model MenuItem {
  id            String       @id @default(uuid())
  name          String
  description   String?
  price         Decimal      // Decimal pour éviter les erreurs d'arrondi sur les prix
  image         String?      // Public URL (Vercel Blob) — aliased as imageUrl
  imagePathname String?      // Internal blob pathname for delete/replace
  available     Boolean      @default(true)
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  deletedAt     DateTime?    // Soft delete

  orderItems OrderItemsOnOrders[]
  recipes    Recipe[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Order {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    OrderStatus @default(pending)
  type      OrderType   @default(dine_in)
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId     String?
  customerId String?
  tableId    String?

  deliveryZoneId  String?
  deliveryAddress String?
  deliveryFee     Decimal? // Decimal pour précision financière
  total           Decimal? // Decimal pour précision financière
  ipAddress       String?
  specialNotes    String?

  deletedAt DateTime? // Soft delete — protège l'historique des commandes (comptabilité)

  user           User?                @relation(fields: [userId], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id])
  table          Table?               @relation(fields: [tableId], references: [id])
  deliveryZone   DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id])
  orderItems     OrderItemsOnOrders[]
  payment        Payment?
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@index([tenantId])
  @@index([tenantId, status])    // Filtrage par statut (dashboard, KDS)
  @@index([tenantId, createdAt]) // Comptage mensuel quota + rapports
  @@index([tenantId, deletedAt]) // Exclusion soft-delete
}

model OrderItemsOnOrders {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String?
  quantity   Int     @default(1)
  price      Decimal // Snapshot du prix au moment de la commande
  name       String
  image      String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @unique
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount    Decimal       // Decimal pour précision financière
  method    PaymentMethod
  status    PaymentStatus @default(completed)
  cashierId String
  // Session de caisse ouverte au moment du paiement, si une l'était — sert
  // à la réconciliation de fermeture de session. Nullable : un paiement
  // reste valide même sans session ouverte (carte/en ligne, ou tenant qui
  // n'utilise pas le cycle de session).
  cashSessionId String?
  cashSession   CashRegisterSession? @relation(fields: [cashSessionId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict : empêche la suppression d'un caissier s'il a des paiements historiques
  cashier User  @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt]) // Filtrage par période (clôture de caisse)
  @@index([cashSessionId])
}

/// Cycle de vie d'une session de caisse : ouverture (fond de caisse initial),
/// activité (paiements liés via Payment.cashSessionId), fermeture avec
/// réconciliation (montant compté vs attendu). Un seul index PARTIEL
/// (WHERE status='open') garantit qu'un tenant n'a jamais deux sessions
/// ouvertes simultanément — voir migration add_cash_register_session.
model CashRegisterSession {
  id       String            @id @default(uuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status   CashSessionStatus @default(open)

  openedBy     String
  openedByUser User     @relation("CashSessionOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  openedAt     DateTime @default(now())
  openingAmount Decimal // Fond de caisse initial (espèces)

  closedBy      String?
  closedByUser  User?     @relation("CashSessionClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  closedAt      DateTime?
  // Montant compté physiquement dans le tiroir à la fermeture
  closingAmount Decimal?
  // openingAmount + total des paiements cash de la session (calculé à la fermeture)
  expectedAmount Decimal?
  // closingAmount - expectedAmount : positif = surplus, négatif = manque
  variance       Decimal?
  notes          String?

  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum CashSessionStatus {
  open
  closed
}

model Ingredient {
  id       String @id @default(uuid())
  name     String
  unit     String
  stock    Float  @default(0)   // Quantité en stock (mesure physique, Float suffisant)
  price    Decimal?             // Prix d'achat (Decimal pour précision financière)
  minStock Float?               // Seuil d'alerte (mesure physique)
  supplier String?
  isActive Boolean @default(true)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt DateTime?           // Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  recipes        Recipe[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model Recipe {
  id           String @id @default(uuid())
  // Dénormalisé depuis menuItem.tenantId : sans cette colonne, tout
  // scoping tenant sur Recipe exige une jointure imbriquée via menuItem,
  // ce qui rend trivial d'oublier le filtre dans une future requête.
  tenantId     String
  menuItemId   String
  ingredientId String
  quantity     Float  // Quantité de l'ingrédient dans la recette (mesure physique)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([tenantId])
}

model Message {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerName String
  email        String
  phone        String?
  subject      String?
  message      String
  read         Boolean       @default(false)
  status       MessageStatus @default(new)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?     // Soft delete

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])  // perf: filter by status per tenant
}

model Report {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title     String
  type      String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model RolePermission {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        String
  permissions Permission[]

  @@unique([tenantId, role])
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  tenantId   String
  permission Permission
  granted    Boolean    @default(true)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, permission])
  @@index([tenantId])
}

model DeliveryZone {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  price        Decimal  // Decimal pour précision financière
  minOrder     Decimal? // Decimal pour précision financière
  deliveryTime Int?
  isActive     Boolean  @default(true)
  polygon      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft delete

  orders Order[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model OpeningHours {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  openTime  String
  closeTime String
  isClosed  Boolean   @default(false)

  @@unique([tenantId, dayOfWeek])
}

model ExceptionalClosure {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date     DateTime
  reason   String?

  @@index([tenantId])
}

model Transaction {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         // Decimal pour précision financière
  method      PaymentMethod
  description String?
  cashierId   String
  orderId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Restrict : empêche la suppression d'un caissier s'il a des transactions historiques
  cashier User   @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  order   Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt]) // Filtrage par période (dashboard, rapports)
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredientId String
  type         StockMovementType
  quantity     Float
  description  String?
  userId       String?
  orderId      String?
  createdAt    DateTime          @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([tenantId])
}

enum TenantStatus {
  active
  suspended
  trial
  expired
}

enum UserStatus {
  active
  inactive
  banned
}

enum PlatformRole {
  user
  support
  super_admin
}

enum TableStatus {
  available
  occupied
  reserved
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

enum OrderStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum PaymentMethod {
  cash
  card
  online
}

enum PaymentStatus {
  completed
  refunded
  cancelled
}

enum Permission {
  VIEW_DASHBOARD
  VIEW_ANALYTICS
  VIEW_ORDERS
  CREATE_ORDERS
  UPDATE_ORDERS
  DELETE_ORDERS
  MANAGE_ORDER_STATUS
  VIEW_MENU
  CREATE_MENU_ITEMS
  UPDATE_MENU_ITEMS
  DELETE_MENU_ITEMS
  VIEW_TABLES
  MANAGE_TABLES
  VIEW_RESERVATIONS
  CREATE_RESERVATIONS
  UPDATE_RESERVATIONS
  DELETE_RESERVATIONS
  VIEW_CUSTOMERS
  MANAGE_CUSTOMERS
  VIEW_CASH_REGISTER
  MANAGE_PAYMENTS
  MANAGE_TRANSACTIONS
  VIEW_REPORTS
  VIEW_INVENTORY
  MANAGE_INVENTORY
  MANAGE_STOCK
  VIEW_STAFF
  MANAGE_STAFF
  MANAGE_PERMISSIONS
  VIEW_SETTINGS
  MANAGE_SETTINGS
  VIEW_MESSAGES
  MANAGE_MESSAGES
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum TransactionType {
  sale
  refund
  adjustment
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MessageStatus {
  new
  read
  replied
  closed
  archived
}
