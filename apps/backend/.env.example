# =============================================================
# Flash Menu — Backend environment variables
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/flash_menu_db"

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotate this secret periodically (invalidates all active sessions).
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"

# ── Application ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4000"

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
# For Gmail use an App Password, not your account password.
SMTP_PASS="your_app_password"
SMTP_FROM="Flash Menu <noreply@flashmenu.app>"

# ── Paiement ──────────────────────────────────────────────────
# Fournisseur de paiement actif (cf. apps/backend/src/payments).
# Aucun fournisseur n'est implémenté à ce jour — "stripe", "paddle",
# "flutterwave" et "paystack" sont des placeholders inertes qui refusent
# toute opération. Ne rien définir ici tant qu'un fournisseur réel n'est
# pas implémenté : PaymentProviderFactory échoue explicitement plutôt que
# de retomber silencieusement sur un provider inactif.
# PAYMENT_PROVIDER="stripe"
#
# Moneroo sera le premier fournisseur réellement implémenté. Une fois son
# provider ajouté (apps/backend/src/payments/providers/moneroo/), ses
# identifiants viendront ici (MONEROO_API_KEY, MONEROO_WEBHOOK_SECRET, ...).

# ── Vercel Blob ───────────────────────────────────────────────
# ⚠️  IMPORTANT: The store MUST be configured with PUBLIC access.
#     Private stores (access: 'private') prevent restaurant customers from
#     viewing menu images — all img src= calls return 403.
#
# How to create/configure a public Vercel Blob store:
#   1. Go to vercel.com/dashboard → Storage → Create Store → Blob
#   2. During creation, select "Public" as the Default Blob Access
#      (or: existing store → Settings → Default Blob Access → Public)
#   3. Paste the BLOB_READ_WRITE_TOKEN from the store's .env.local tab below.
#
# Get this from Vercel Dashboard → Storage → your store → .env.local tab
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REPLACE"

# ── Menu session (HMAC token anti-flooding) ──────────────────────────────────
# Distinct from JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MENU_SESSION_SECRET="REPLACE_WITH_RANDOM_32_BYTES_HEX"

# ── Redis (shared rate limiting + idempotency in multi-instance) ─────────────
# Required for production multi-instance deployments.
# Format: redis://:PASSWORD@HOST:6379
REDIS_URL="redis://:changeme_redis@localhost:6379"
REDIS_PASSWORD="changeme_redis"

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Optional — service degrades gracefully when absent.
# Get your DSN from https://sentry.io → Project → Client Keys → DSN
SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"

# ── Seed credentials (development only) ──────────────────────
# These are only used by prisma/seed-admin.ts — never in production.
SEED_ADMIN_PASSWORD="REPLACE_STRONG_PASSWORD"
SEED_MANAGER_PASSWORD="REPLACE_STRONG_PASSWORD"
