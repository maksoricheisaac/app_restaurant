generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGICIEL MONO-ÉTABLISSEMENT
//
// Cette base décrit UN SEUL restaurant. Il n'y a plus de notion de tenant, de
// plan, d'abonnement ni de quota : toute ligne de toute table appartient, par
// construction, à l'unique établissement décrit par le modèle `Restaurant`.
//
// Conséquence directe : aucune table ne porte de colonne de cloisonnement.
// Une requête n'a plus jamais besoin d'être « scopée » — l'oubli d'un filtre
// de sécurité, principale classe de bugs de l'ancienne architecture, devient
// structurellement impossible.
// ─────────────────────────────────────────────────────────────────────────────

/// Identité, configuration et paramétrage de l'unique établissement.
///
/// Singleton strict : la colonne `id` est verrouillée par une contrainte SQL
/// CHECK (id = 'restaurant') posée en migration. Toute tentative d'insérer un
/// second établissement échoue au niveau de la base, pas seulement du code.
model Restaurant {
  id String @id @default("restaurant")

  // ── Identité ──────────────────────────────────────────────────────────────
  name        String
  slogan      String?
  description String?
  cuisineType String?

  logo           String? // URL publique (Vercel Blob)
  logoPathname   String? // Chemin interne blob, pour suppression/remplacement
  bannerUrl      String?
  bannerPathname String?
  primaryColor   String  @default("#f97316")

  // ── Coordonnées ───────────────────────────────────────────────────────────
  phone   String?
  email   String?
  address String?
  website String?

  // ── Localisation ──────────────────────────────────────────────────────────
  country  String?
  currency String  @default("EUR")
  timezone String  @default("Europe/Paris")

  // ── Réseaux sociaux ───────────────────────────────────────────────────────
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?

  // ── Service & prise de commande ───────────────────────────────────────────
  dineInEnabled        Boolean @default(true)
  takeawayEnabled      Boolean @default(true)
  deliveryEnabled      Boolean @default(true)
  maxOrdersPerHour     Int     @default(10)
  maxOrdersPerUserHour Int     @default(3)
  maxReservationGuests Int     @default(20)
  maxDaysInAdvance     Int     @default(30)

  // ── Caisse ────────────────────────────────────────────────────────────────
  /// Méthode proposée par défaut à l'encaissement.
  defaultPaymentMethod PaymentMethod @default(cash)
  /// Taux de TVA appliqué, en pourcentage (ex. 20 = 20 %).
  taxRate              Decimal       @default(0)
  /// true = les prix du menu sont TTC, false = HT (taxe ajoutée à l'encaissement).
  taxIncluded          Boolean       @default(true)
  /// Exige l'ouverture d'une session de caisse avant tout encaissement espèces.
  requireCashSession   Boolean       @default(true)
  /// Fond de caisse proposé par défaut à l'ouverture de session.
  defaultOpeningFloat  Decimal       @default(0)

  // ── Impression ────────────────────────────────────────────────────────────
  /// Nom de l'imprimante ticket (tel que déclaré par le poste de caisse).
  receiptPrinterName     String?
  /// Nom de l'imprimante cuisine. Null = même imprimante que les tickets.
  kitchenPrinterName     String?
  /// Largeur du papier en millimètres (58 ou 80 sur la quasi-totalité des
  /// imprimantes thermiques du marché).
  receiptPaperWidth      Int     @default(80)
  receiptHeader          String?
  receiptFooter          String?
  autoPrintReceipt       Boolean @default(false)
  /// Envoi automatique du bon de préparation en cuisine à la validation.
  autoPrintKitchenTicket Boolean @default(true)

  // ── Première installation ─────────────────────────────────────────────────
  /// Passe à true à la fin de l'assistant de première installation. Une fois
  /// true, l'assistant ne réapparaît jamais.
  setupCompleted   Boolean   @default(false)
  setupCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉQUIPE & ACCÈS
// ─────────────────────────────────────────────────────────────────────────────

/// Membre de l'équipe. Le rôle est porté directement par l'utilisateur : il
/// n'existe qu'un établissement, donc au plus un rôle par personne. C'est ce
/// qui a permis de supprimer la table de liaison TenantMembership et, avec
/// elle, une requête SQL sur chaque appel authentifié.
///
/// Valeurs autorisées de `role` : super_admin | owner | manager | waiter |
/// chef | cashier. Contrainte CHECK posée en migration (voir StaffRole dans
/// src/common/constants/staff-roles.constant.ts).
///
/// Deux règles supplémentaires, non exprimables en Prisma, vivent dans la
/// migration `super_admin` :
///   - index unique PARTIEL `User_single_super_admin_key` sur (role) WHERE
///     role = 'super_admin' : il n'existe jamais plus d'un compte racine ;
///   - le rôle 'super_admin' ne s'obtient que par la première installation.
model User {
  id            String  @id @default(uuid())
  name          String
  firstName     String?
  lastName      String?
  email         String  @unique
  emailVerified Boolean @default(false)
  password      String
  image         String?
  phone         String?

  status UserStatus @default(active)
  role   String     @default("waiter")

  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?

  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders              Order[]
  payments            Payment[]
  reservations        Reservation[]
  stockMovements      StockMovement[]
  transactions        Transaction[]
  userPermissions     UserPermission[]
  refreshTokens       RefreshToken[]
  cashSessionsOpened  CashRegisterSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed  CashRegisterSession[] @relation("CashSessionClosedBy")
  invitesSent         StaffInvite[]         @relation("InviteInvitedBy")
  auditLogs           AuditLog[]
  orderLinesCancelled OrderLine[]           @relation("OrderLineCancelledBy")

  @@index([role])
}

/// Piste d'audit des opérations sensibles : qui a fait quoi, sur quoi, quand,
/// et avec quel résultat.
///
/// Écrite en base et non plus seulement dans les journaux applicatifs — un
/// fichier de log tourne, n'est pas interrogeable et ne survit pas à un
/// redéploiement. C'est le socle des exigences d'inaltérabilité de la
/// comptabilité (phase 4) : la table est en écriture seule côté application,
/// aucun service n'expose de mise à jour ni de suppression.
///
/// Aucune contrainte d'unicité : deux actions identiques à la même
/// milliseconde sont deux faits distincts, tous deux à conserver.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  /// Auteur. Null pour un appel anonyme (parcours client public).
  /// `onDelete: SetNull` : la suppression d'un compte ne doit jamais effacer
  /// la trace de ce qu'il a fait — d'où la dénormalisation ci-dessous.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identité recopiée au moment du fait : survit à la suppression du compte.
  userEmail String?
  userRole  String?

  /// Action métier normalisée : « payment.process », « order.update_status »…
  action   String
  /// Nature et identifiant de l'objet touché, quand ils sont identifiables.
  entity   String?
  entityId String?

  method     String
  path       String
  statusCode Int
  ip         String?
  userAgent  String?
  requestId  String?
  durationMs Int?

  /// État avant / après, pour les actions qui modifient une donnée sensible.
  /// Renseignés par les services qui connaissent réellement ces deux états ;
  /// pour une création, seul `after` a un sens.
  before Json?
  after  Json?

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
}

/// Invitation d'un employé n'ayant pas encore de compte. Seul le hash SHA-256
/// du jeton est stocké ; le jeton brut n'existe que dans le lien envoyé par
/// email.
///
/// Unicité supplémentaire non exprimable en Prisma : un index unique PARTIEL
/// sur (email) WHERE status='pending' garantit qu'une adresse n'a jamais deux
/// invitations en attente — voir StaffInvite_one_pending_per_email_key dans la
/// migration single_restaurant.
model StaffInvite {
  id String @id @default(uuid())

  email     String
  role      String
  tokenHash String       @unique
  status    InviteStatus @default(pending)

  invitedBy     String
  invitedByUser User   @relation("InviteInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([email])
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime? // Null = jamais utilisé. Non-null = utilisé → replay si réutilisé

  @@index([userId])
  @@index([userId, usedAt])
}

/// Permissions par défaut d'un rôle. Une ligne par rôle.
model RolePermission {
  id          String       @id @default(uuid())
  role        String       @unique
  permissions Permission[]
}

/// Dérogation individuelle : accorde (granted=true) ou retire (granted=false)
/// une permission à un utilisateur, par-dessus les permissions de son rôle.
model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  permission Permission
  granted    Boolean    @default(true)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id String @id @default(uuid())

  name         String?
  email        String?
  phone        String?
  authProvider String? // email | google | anonymous
  externalId   String? // google id
  isAnonymous  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  orders Order[]

  @@index([email])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SALLE
// ─────────────────────────────────────────────────────────────────────────────

model Table {
  id       String      @id @default(uuid())
  number   Int
  seats    Int
  location String?
  status   TableStatus @default(available)

  deletedAt DateTime? // Soft delete — unicité de `number` gérée par index partiel

  orders       Order[]
  reservations Reservation[]

  // Unicité réelle : index unique PARTIEL sur (number) WHERE "deletedAt" IS NULL,
  // créé en SQL brut — une table supprimée libère son numéro.
  @@index([number])
  @@index([deletedAt])
}

model Reservation {
  id     String            @id @default(uuid())
  date   DateTime
  time   String?
  guests Int?
  status ReservationStatus @default(pending)

  customerName String?
  email        String?
  phone        String?
  userId       String?
  tableId      String?

  deletedAt DateTime? // Soft delete — protège l'historique des réservations

  table Table? @relation(fields: [tableId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([deletedAt])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// CARTE
// ─────────────────────────────────────────────────────────────────────────────

model MenuCategory {
  id            String    @id @default(uuid())
  name          String
  imageUrl      String?
  imagePathname String?
  deletedAt     DateTime?

  items MenuItem[]

  @@index([deletedAt])
}

model MenuItem {
  id            String       @id @default(uuid())
  name          String
  description   String?
  price         Decimal // Decimal pour éviter les erreurs d'arrondi sur les prix
  /// Taux de TVA de l'article, en pourcentage. Null = taux par défaut de
  /// l'établissement (`Restaurant.taxRate`). Un taux par article est ce qui
  /// permet de facturer une bouteille de vin et un plat au même ticket sans
  /// les confondre.
  taxRate       Decimal?
  image         String? // URL publique (Vercel Blob) — exposée comme imageUrl
  imagePathname String?
  available     Boolean      @default(true)
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  deletedAt     DateTime?

  orderItems   OrderLine[]
  recipes      Recipe[]
  optionGroups MenuItemOptionGroup[]

  @@index([categoryId])
  @@index([deletedAt])
}

/// Groupe d'options d'un plat (ex. « Cuisson », « Suppléments »).
/// - required + minSelect : force un choix minimal (ex. cuisson obligatoire).
/// - maxSelect : 1 = choix unique (radio), >1 = multi borné, 0 = illimité.
/// La validation required/min/max est TOUJOURS refaite côté serveur.
model MenuItemOptionGroup {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name      String
  required  Boolean @default(false)
  minSelect Int     @default(0)
  maxSelect Int     @default(1) // 0 = illimité
  sortOrder Int     @default(0)

  deletedAt DateTime? // Soft delete — préserve les commandes historiques

  options MenuItemOption[]

  @@index([menuItemId])
  @@index([menuItemId, deletedAt])
}

/// Option individuelle au sein d'un groupe. `priceDelta` s'ajoute (ou se
/// retranche) au prix du plat. Le prix réel facturé est TOUJOURS relu en base
/// au moment de la commande, jamais fait confiance au client.
model MenuItemOption {
  id      String              @id @default(uuid())
  groupId String
  group   MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name       String
  priceDelta Decimal @default(0)
  available  Boolean @default(true)
  sortOrder  Int     @default(0)

  deletedAt DateTime?

  @@index([groupId])
  @@index([groupId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMANDES
// ─────────────────────────────────────────────────────────────────────────────

/// Un ticket. Il naît à la première saisie et vit jusqu'à l'encaissement :
/// entre les deux, des lignes s'ajoutent au fil du service.
///
/// `status` n'est jamais posé à la main : il est TOUJOURS recalculé depuis
/// l'état des lignes (voir `deriveOrderStatus`). C'est ce qui garantit qu'un
/// ticket ne peut pas afficher « prêt » alors qu'une ligne vient d'être
/// ajoutée, incohérence que rien n'empêchait tant que le statut était porté
/// par la commande seule.
model Order {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    OrderStatus @default(open)
  type      OrderType   @default(dine_in)

  /// Numéro affiché sur le ticket, remis à 1 chaque jour de service.
  /// Attribué par `TicketCounter` dans la transaction de création : un
  /// rollback reprend le numéro, la séquence reste donc sans trou.
  number      Int
  /// Jour de service (date civile dans le fuseau de l'établissement) auquel
  /// se rattache `number`.
  serviceDate DateTime @db.Date

  userId     String?
  customerId String?
  tableId    String?

  deliveryZoneId  String?
  deliveryAddress String?
  deliveryFee     Decimal?
  /// Montant TTC — ce que le client paie. Recalculé depuis les lignes.
  total           Decimal?

  // ── Taxe ──────────────────────────────────────────────────────────────────
  /// Régime de prix en vigueur à l'ouverture du ticket : true = les prix
  /// saisis sont TTC, false = HT. Figé ici parce qu'un établissement qui
  /// bascule son paramétrage ne doit pas changer rétroactivement le sens de
  /// calcul des tickets déjà ouverts.
  taxIncluded     Boolean  @default(true)
  /// Taux appliqué aux frais de livraison, figé à l'ouverture.
  deliveryTaxRate Decimal?
  /// Totaux ventilés, recalculés depuis les lignes à chaque opération.
  subtotalExclTax Decimal?
  taxTotal        Decimal?
  ipAddress       String?
  specialNotes    String?

  /// Horodatage de l'encaissement. Non nul = ticket clos : plus aucune ligne
  /// ne peut être ajoutée, modifiée ou annulée.
  closedAt  DateTime?
  deletedAt DateTime? // Soft delete — protège l'historique (comptabilité)

  user           User?           @relation(fields: [userId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  table          Table?          @relation(fields: [tableId], references: [id])
  deliveryZone   DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  orderItems     OrderLine[]
  payment        Payment?
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@unique([serviceDate, number])
  @@index([status]) // KDS, tableau de bord
  @@index([createdAt]) // Rapports, historique
  @@index([deletedAt])
  @@index([tableId, status]) // Reprise du ticket ouvert d'une table
}

/// Ligne d'un ticket, avec son propre cycle de vie.
///
/// Le nom de table reste `OrderItemsOnOrders`, hérité de l'époque où ce
/// n'était qu'une table de liaison ; le modèle porte désormais un nom qui dit
/// ce qu'il est. Le renommage est purement applicatif — aucune donnée ne
/// bouge.
model OrderLine {
  id        String   @id @default(uuid())
  /// Instant de saisie. Ordonne les lignes d'un ticket qui se remplit au fil
  /// du service — sans quoi une tournée ajoutée en fin de repas pourrait
  /// s'afficher avant l'entrée.
  createdAt DateTime @default(now())

  orderId    String
  menuItemId String?
  quantity   Int     @default(1)
  price      Decimal // Snapshot du prix (plat + options) au moment de la commande
  name       String
  image      String?

  // ── Taxe, figée à la saisie de la ligne ───────────────────────────────────
  //
  // Les trois montants portent sur la ligne ENTIÈRE, quantité comprise : la
  // taxe calculée par unité puis multipliée dérive d'un centime dès qu'un
  // article part en nombre. Ils sont figés à la saisie — un changement de
  // taux sur la carte ne réécrit jamais un ticket déjà pris.
  /// Taux appliqué, en pourcentage (20 = 20 %).
  taxRate     Decimal @default(0)
  lineExclTax Decimal @default(0)
  lineTax     Decimal @default(0)
  lineInclTax Decimal @default(0)
  /// Snapshot des options choisies : [{ groupName, optionName, priceDelta }].
  /// Figé à la commande pour rester lisible même si l'option change ensuite.
  options     Json?

  status OrderLineStatus @default(draft)

  /// Départ en cuisine. C'est cet instant — et non la création du ticket —
  /// qui décrémente le stock : un brouillon abandonné ne doit rien consommer.
  /// Les lignes parties ensemble partagent cet horodatage : c'est ce qui
  /// identifie une tournée, sans colonne supplémentaire.
  sentAt DateTime?

  /// Annulation d'une ligne DÉJÀ partie en cuisine : elle reste sur le ticket,
  /// barrée et motivée, parce qu'elle a consommé du stock et du travail. Une
  /// ligne encore en brouillon est simplement supprimée.
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  cancelledByUser User?     @relation("OrderLineCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status]) // Écran cuisine : les lignes parties, tous tickets confondus
  @@map("OrderItemsOnOrders")
}

/// Compteur de numérotation des tickets, une ligne par jour de service.
///
/// Une table plutôt qu'une séquence PostgreSQL : une séquence ne se remet pas
/// à zéro chaque jour et, surtout, ne se rembobine pas si la transaction
/// échoue — elle laisserait des trous dans la numérotation.
model TicketCounter {
  serviceDate DateTime @id @db.Date
  lastNumber  Int      @default(0)
}

// ─────────────────────────────────────────────────────────────────────────────
// CAISSE
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id      String @id @default(uuid())
  orderId String @unique

  amount    Decimal
  method    PaymentMethod
  status    PaymentStatus @default(completed)
  cashierId String

  /// Session de caisse ouverte au moment du paiement, si une l'était — sert à
  /// la réconciliation de fermeture. Nullable : un paiement carte/en ligne
  /// reste valide sans session ouverte.
  cashSessionId String?
  cashSession   CashRegisterSession? @relation(fields: [cashSessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict : empêche la suppression d'un caissier ayant des paiements historiques
  cashier User  @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([createdAt]) // Clôture de caisse, rapports
  @@index([cashSessionId])
}

/// Cycle de vie d'une session de caisse : ouverture (fond de caisse),
/// activité (paiements liés via Payment.cashSessionId), fermeture avec
/// réconciliation (compté vs attendu).
///
/// Un index unique PARTIEL (WHERE status='open') garantit qu'il n'existe
/// jamais deux sessions ouvertes simultanément.
model CashRegisterSession {
  id     String            @id @default(uuid())
  status CashSessionStatus @default(open)

  openedBy      String
  openedByUser  User     @relation("CashSessionOpenedBy", fields: [openedBy], references: [id], onDelete: Restrict)
  openedAt      DateTime @default(now())
  openingAmount Decimal // Fond de caisse initial (espèces)

  closedBy       String?
  closedByUser   User?     @relation("CashSessionClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  closedAt       DateTime?
  /// Montant compté physiquement dans le tiroir à la fermeture
  closingAmount  Decimal?
  /// openingAmount + total des paiements espèces de la session
  expectedAmount Decimal?
  /// closingAmount - expectedAmount : positif = surplus, négatif = manque
  variance       Decimal?
  notes          String?

  payments Payment[]

  @@index([status])
  @@index([openedAt])
}

enum CashSessionStatus {
  open
  closed
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  amount      Decimal
  method      PaymentMethod
  description String?
  cashierId   String
  orderId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Restrict : empêche la suppression d'un caissier ayant des transactions historiques
  cashier User   @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  order   Order? @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id        String    @id @default(uuid())
  name      String
  unit      String
  stock     Float     @default(0) // Quantité en stock (mesure physique)
  price     Decimal? // Prix d'achat (Decimal pour précision financière)
  minStock  Float? // Seuil d'alerte
  supplier  String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  recipes        Recipe[]

  @@index([deletedAt])
}

model Recipe {
  id           String @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Float // Quantité de l'ingrédient dans la recette

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
}

model StockMovement {
  id           String            @id @default(uuid())
  ingredientId String
  type         StockMovementType
  quantity     Float
  description  String?
  userId       String?
  orderId      String?
  createdAt    DateTime          @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@index([ingredientId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// LIVRAISON & HORAIRES
// ─────────────────────────────────────────────────────────────────────────────

model DeliveryZone {
  id           String    @id @default(uuid())
  name         String
  description  String?
  price        Decimal
  minOrder     Decimal?
  deliveryTime Int?
  isActive     Boolean   @default(true)
  polygon      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders Order[]

  @@index([deletedAt])
}

model OpeningHours {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek @unique
  openTime  String
  closeTime String
  isClosed  Boolean   @default(false)
}

model ExceptionalClosure {
  id     String   @id @default(uuid())
  date   DateTime
  reason String?

  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION & RAPPORTS
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id           String        @id @default(uuid())
  customerName String
  email        String
  phone        String?
  subject      String?
  message      String
  read         Boolean       @default(false)
  status       MessageStatus @default(new)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  @@index([status])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  banned
}

enum TableStatus {
  available
  occupied
  reserved
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

/// Avancement d'un ticket. Toujours dérivé de l'état de ses lignes.
enum OrderStatus {
  /// Au moins une ligne en brouillon : le ticket est en cours de saisie.
  open
  /// Tout est parti en cuisine, rien n'a encore été pris en charge.
  pending
  /// Au moins une ligne en préparation.
  preparing
  /// Toutes les lignes parties sont prêtes.
  ready
  /// Toutes les lignes ont été servies.
  served
  /// Encaissé : le ticket est clos et ses lignes verrouillées.
  paid
  /// Ticket annulé dans son ensemble.
  cancelled
}

/// Cycle de vie d'une ligne de ticket.
enum OrderLineStatus {
  /// Saisie, pas encore envoyée en cuisine. Modifiable et supprimable.
  draft
  /// Partie en cuisine : le stock est consommé, l'annulation exige un motif.
  sent
  preparing
  ready
  served
  cancelled
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum PaymentMethod {
  cash
  card
  online
}

enum PaymentStatus {
